Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: base_link
    Background Color: 48; 48; 48
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Plane: XY
      Cell Size: 0.1
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Topic:
        Value: /object_digital_twin/markers
      Name: Editable object twin
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Topic:
        Value: /object_detector_dbscan_sam_cull/object_points
      Name: Segmented observation
      Style: Points
      Size (Pixels): 3
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Topic:
        Value: /object_digital_twin/confidence_points
      Name: Confidence-scored accumulated surface
      Style: Points
      Size (Pixels): 5
      Color Transformer: RGB8
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.4
      Pitch: 0.65
      Yaw: 0.8
