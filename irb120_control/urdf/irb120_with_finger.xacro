<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="abb_irb120_3_58">

  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="use_fake_hardware" default="false"/>
  <xacro:arg name="fake_sensor_commands" default="false"/>
  <xacro:arg name="rws_ip" default="None"/>
  <xacro:arg name="rws_port" default="80"/>
  <xacro:arg name="rws_username" default="ROS"/>
  <xacro:arg name="rws_password" default="robotics"/>
  <xacro:arg name="egm_port" default="6511"/>
  <xacro:arg name="configure_via_rws" default="true"/>

  <xacro:property name="prefix" value="$(arg prefix)"/>
  <xacro:property name="use_fake_hardware" value="$(arg use_fake_hardware)"/>
  <xacro:property name="fake_sensor_commands" value="$(arg fake_sensor_commands)"/>
  <xacro:property name="rws_ip" value="$(arg rws_ip)"/>
  <xacro:property name="rws_port" value="$(arg rws_port)"/>
  <xacro:property name="rws_username" value="$(arg rws_username)"/>
  <xacro:property name="rws_password" value="$(arg rws_password)"/>
  <xacro:property name="egm_port" value="$(arg egm_port)"/>
  <xacro:property name="configure_via_rws" value="$(arg configure_via_rws)"/>

  <xacro:include filename="$(find irb120_control)/urdf/irb120_3_58_macro.xacro"/>
  <xacro:include filename="$(find irb120_control)/urdf/irb120_3_58.ros2_control.xacro"/>
  <xacro:abb_irb120_3_58 prefix="${prefix}"/>

  <xacro:abb_irb120_3_58_ros2_control
    name="ABBSystemHardware"
    prefix="${prefix}"
    use_fake_hardware="${use_fake_hardware}"
    fake_sensor_commands="${fake_sensor_commands}"
    rws_ip="${rws_ip}"
    rws_port="${rws_port}"
    rws_username="${rws_username}"
    rws_password="${rws_password}"
    egm_port="${egm_port}"
    configure_via_rws="${configure_via_rws}"/>

  <!-- ====== Params to tweak ====== -->
  <xacro:property name="ft_length" value="0.08225"/>           <!-- FT sensor length (measured) -->
  <xacro:property name="finger_mass" value="0.066"/>           <!-- kg (measured finger+ball+screws) -->
  <xacro:property name="finger_cog" value="0.0275"/>         <!-- meters in finger frame (measured) -->
  <xacro:property name="finger_length" value="0.100"/>         <!-- finger length (measured)-->
  <xacro:property name="finger_ball_radius" value="0.01312"/>  <!-- Ball radius (measured 26.25 mm diameter)-->
  <xacro:property name="finger_contact" value="0.0875"/>     <!-- finger contact length (measured ball center from base)-->
  <xacro:property name="finger_mesh" value="package://irb120_control/urdf/pusher_link.stl"/>
  <!-- Total offset from link_6 to finger tip will be ft_length + finger_length -->
  <!-- Total offset from link_6 to contact point will be ft_length + finger_contact -->

  <xacro:property name="table_thickness" value="0.044"/> <!-- Visual feature -->
  <xacro:property name="bracket_thickness" value="0.021"/>
  <xacro:property name="table_center_x" value="0.40"/> <!-- Mostly visual, maybe for workspace bounds -->
  <xacro:property name="table_center_y" value="0.0"/>

  <!-- world: base_link is at x=y=0; table top surface is z=0 -->
  <link name="world"/>

  <!-- ====== Table that the robot and object rest on (for collision and visuals) ====== -->
  <link name='table'>
    <visual>
      <origin xyz="0 0 -${table_thickness / 2}" rpy="0 0 0"/>
      <geometry>
        <box size="2.0 0.8 ${table_thickness}"/>
      </geometry>
      <material name="TableLight">
        <color rgba="0.965 0.965 0.945 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -${table_thickness / 2}" rpy="0 0 0"/> <!-- At the center, bottom of table-->
      <geometry>
        <box size="2.0 0.8 ${table_thickness}"/>
      </geometry>
    </collision>
  </link>

  <!-- ====== Bracket that robot sits on, ontop of the table ====== -->
  <link name='bracket'>
    <visual>
      <origin xyz="0 0 ${bracket_thickness / 2}" rpy="0 0 0"/>
      <geometry>
        <box size="0.194 0.8 ${bracket_thickness}"/>
      </geometry>
      <material name="LightGrey">
        <color rgba="0.8 0.8 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${bracket_thickness / 2}" rpy="0 0 0"/>
      <geometry>
        <box size="0.194 0.8 ${bracket_thickness}"/>
      </geometry>
    </collision>
  </link>


  <!-- ====== FT sensor + adapter stack, mounted to tool0 ====== -->
  <!-- Accurate geometry/mass/collision now comes from the Onshape CAD export below
       (root -> adapter_robot -> adapter_sensor -> sensor_plate -> sensor_body),
       replacing the old hand-measured stand-in cylinder.

       ft_link itself stays a bare frame (no visual/collision/inertial — same pattern
       as finger_ball_center below) pinned EXACTLY where it always was: coincident
       with tool0 (tool0_to_ft is identity). Do not move it or give it mass/inertia —
       netft_preprocessor.py, calibrate_ft_sensor.py, and estimation/tst.py all
       hardcode "ft_link" as the wrench TF frame and assume this exact position
       (see tst.py's docstring); moving it or double-counting its mass against the
       new CAD links' own inertials would silently break their lever-arm math. -->
  <link name="ft_link"/>

  <!-- Onshape CAD export: located in irb120_control/urdf/sensor_and_adapter_assembly.
       Grafted onto tool0 as its own branch (parallel to ft_link/finger_link above),
       not merged into the ft_link/finger chain. -->
  <xacro:include filename="$(find irb120_control)/urdf/sensor_and_adapter_assembly/sensor_and_adapter_assembly.urdf"/>

  <!-- ====== Finger link ====== -->
  <link name="finger_link">
    <inertial>
        <origin xyz="${finger_cog} 0 0" rpy="0 1.5708 0"/>   <!-- Rotate for correct attachment and orientation -->
        <mass value="${finger_mass}"/>
        <inertia ixx="70.297" iyy="70.297" izz="70.297" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
        <geometry>
          <mesh filename="${finger_mesh}"/>
        </geometry>
        <material name="White">
            <color rgba="1.0 1.0 1.0 1.0"/>
        </material>
    </visual>
    <collision>
        <origin xyz="0 0 0" rpy="0 1.5708 0"/>
        <geometry>
            <mesh filename="${finger_mesh}"/>
        </geometry>
    </collision>
  </link>

  <!-- ==================================== JOINTS ==================================== -->

  <!-- connect tool0 to ft_link -->
  <joint name="tool0_to_ft" type="fixed">
    <parent link="tool0"/>
    <origin
      xyz="0 0 0"
      rpy="0 0 0"/> <!-- Now we re-orient the FT sensor internally (net ft settings configuration)-->
    <child link="ft_link"/>
  </joint>

  <!-- connect tool0 to the Onshape assembly's root mate connector.
       Starting with identity: assumes the mate connector picked as "root" when
       exporting from Onshape was oriented to match tool0's convention (Z out
       along the approach direction). VERIFY VISUALLY IN RVIZ — if the assembly
       renders rotated/flipped relative to the real sensor mounting, adjust this
       joint's rpy (nothing else needs to change; ft_link/finger_link above are
       on a separate branch and unaffected either way). -->
  <joint name="tool0_to_root" type="fixed">
    <parent link="tool0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <child link="root"/>
  </joint>

  <!-- connect ft_link to finger_link -->
  <joint name="ft_to_finger" type="fixed">
    <parent link="ft_link"/>
    <origin
      xyz="${ft_length} 0 0"
      rpy="0 0 0"/>
    <child link="finger_link"/>
  </joint>

  <!-- finger_ball_center at contact point for EE position (like mujoco 'site') -->
  <link name="finger_ball_center"/>
  <joint name="finger_to_ball_center" type="fixed">
    <parent link="finger_link"/>
    <origin xyz="${finger_contact} 0 0" rpy="0 0 0"/>
    <child link="finger_ball_center"/>
  </joint>

  <!-- World and table should coincide, at the top table surface -->
  <joint name="world_to_table" type="fixed">
    <parent link="world"/>
    <origin xyz="${table_center_x} ${table_center_y} 0" rpy="0 0 0"/>
    <child link="table"/>
  </joint>

  <joint name="world_to_bracket" type="fixed">
    <parent link="world"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <child link="bracket"/>
  </joint>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <origin xyz="0 0 ${bracket_thickness}" rpy="0 0 0"/>
    <child link="base_link"/>
  </joint>

</robot>